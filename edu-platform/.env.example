# =====================================================================
# متغيرات البيئة — انسخ هذا الملف إلى .env.local (محليًا) أو أضفها في Vercel
# لا تضع أي مفتاح سري في متغير يبدأ بـ NEXT_PUBLIC_
# =====================================================================

# رابط الموقع العام (يُستخدم في روابط الدفع والبريد و SEO)
APP_URL=http://localhost:3000

# سر عشوائي طويل (32 حرفًا على الأقل) — ولّده بـ: openssl rand -base64 48
APP_SECRET=

# ---------------------------------------------------------------------
# قاعدة البيانات (PostgreSQL / Supabase)
# محليًا: postgres://USER:PASSWORD@localhost:5432/DBNAME
# Supabase (Vercel): استخدم رابط Transaction pooler (المنفذ 6543) واضبط DATABASE_PGBOUNCER=true
# ---------------------------------------------------------------------
DATABASE_URL=
DATABASE_PGBOUNCER=false
DATABASE_POOL_MAX=5

# ---------------------------------------------------------------------
# التخزين: local (قرص الخادم) أو supabase (موصى به للإنتاج على Vercel)
# ---------------------------------------------------------------------
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./storage
SUPABASE_URL=
# مفتاح service_role — سري جدًا، يُستخدم على الخادم فقط
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PRIVATE_BUCKET=private-content
SUPABASE_PUBLIC_BUCKET=public-media

# ---------------------------------------------------------------------
# الدفع (MyFatoorah)
# disabled: لا دفع إلكتروني | sandbox: بيئة الاختبار | live: الإنتاج
# ---------------------------------------------------------------------
PAYMENTS_MODE=disabled
MYFATOORAH_API_KEY=
# اتركه فارغًا لاستخدام الرابط الرسمي حسب الوضع:
# sandbox → https://apitest.myfatoorah.com   |   live (الكويت) → https://api.myfatoorah.com
MYFATOORAH_BASE_URL=
# مفتاح توقيع Webhook V2 من لوحة MyFatoorah (إلزامي، حتى في sandbox)
MYFATOORAH_WEBHOOK_SECRET=
# يجب ضبطه على true صراحةً لتفعيل وضع الإنتاج بعد اعتماد حساب التاجر
MYFATOORAH_LIVE_CONFIRMED=false

# سر وظيفة التسوية الدورية /api/cron/reconcile-payments. يرسله Vercel في Authorization: Bearer.
# قيمة عشوائية من ١٦ حرفًا على الأقل (مثال: openssl rand -hex 32). بدونه يرد المسار 401 ولا تعمل الوظيفة.
CRON_SECRET=
# sandbox محظور على نشر NODE_ENV=production بنطاق لا يدل على اختبار.
# اضبطه على true فقط لتجربة مقصودة على ذلك النشر. (معاينات Vercel والنطاقات مثل staging.* مسموحة تلقائيًا)
ALLOW_SANDBOX_ON_PRODUCTION=false

# ---------------------------------------------------------------------
# البريد (استعادة كلمة المرور)
# log: يسجّل الرسائل في قاعدة البيانات فقط (للتطوير) | smtp: إرسال فعلي
# ---------------------------------------------------------------------
# log: الرسائل تُسجَّل داخل المنصة ولا تصل إلى أحد، ولا يوجد رابط استعادة بالبريد ولا تأكيد بريد.
# smtp: إرسال حقيقي، ويتطلب SMTP_HOST و MAIL_FROM بعنوان صحيح. يُفرض عندها تأكيد البريد قبل أول دفع.
MAIL_DRIVER=log
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
MAIL_FROM="منصة فرقد <no-reply@your-domain.com>"

# ---------------------------------------------------------------------
# الفيديو
# file : الفيديو يُرفع للتخزين الخاص للمنصة ويُبث عبر الخادم (للتطوير أو الأحجام الصغيرة)
# bunny: Bunny Stream (موصى به للإنتاج): رفع مباشر TUS، جودات متعددة تلقائية، روابط تضمين موقعة
# ---------------------------------------------------------------------
VIDEO_PROVIDER=file
BUNNY_STREAM_LIBRARY_ID=
# مفتاح API للمكتبة (سري)
BUNNY_STREAM_API_KEY=
# Embed view token authentication key من إعدادات الأمان في المكتبة (سري)
BUNNY_STREAM_TOKEN_KEY=
# مفتاح القراءة فقط — للتحقق من توقيع Webhook (إلزامي في الإنتاج)
BUNNY_STREAM_READONLY_API_KEY=
# نطاق CDN للمكتبة لصور المعاينة التلقائية (مثل vz-xxxxxxx-xxx.b-cdn.net)
BUNNY_STREAM_CDN_HOSTNAME=

# true عند التشغيل خلف وكيل موثوق (Vercel) لقراءة عنوان IP الحقيقي
TRUST_PROXY=true
