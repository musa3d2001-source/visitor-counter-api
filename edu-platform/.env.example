# =====================================================================
# Environment variables
#
# Copy this file to .env.local for local work, or enter the same names in
# Vercel (Project -> Settings -> Environment Variables). Production and
# Preview are separate there; a change takes effect only after a redeploy.
#
# This list matches exactly the names src/server/env.ts reads.
# tests/unit/env-example.test.ts fails if the two ever differ.
#
# Rules:
# - Values here are safe placeholders only. Never commit a real secret.
# - Never put a secret in a variable whose name starts with NEXT_PUBLIC_.
# - A line that starts with "# NAME=" is optional and left unset on purpose.
#   Uncomment it only when you give it a real value: some of these fail
#   validation when present but empty (for example a URL), and the server
#   would refuse to start.
# - Keep comments on their own line; do not add a comment after a value.
# =====================================================================

# ---------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------

# Public address of the site. Used in payment return links, emails and SEO.
# In production: the real domain with https, exactly the host students open
# (with or without www, not both).
APP_URL=http://localhost:3000

# false hides this deployment from search engines. A *.vercel.app address is
# never indexed, whatever this says.
SITE_INDEXABLE=true

# Required. Random secret of at least 32 characters, used to sign temporary
# links and to protect two-factor data. Generate: openssl rand -base64 48
APP_SECRET=

# true reads the visitor IP from the proxy headers. Keep true on Vercel; set
# false only when the server is not behind a trusted proxy.
TRUST_PROXY=true

# Set by Next.js (development / production / test). Do not set it by hand.
# NODE_ENV=production

# Set by Vercel automatically (production / preview / development).
# VERCEL_ENV=production

# ---------------------------------------------------------------------
# Database (PostgreSQL / Supabase)
# ---------------------------------------------------------------------

# Required. Local: postgres://USER:PASSWORD@localhost:5432/DBNAME
# Supabase on Vercel: the Transaction pooler URL (port 6543), with
# DATABASE_PGBOUNCER set to true below.
DATABASE_URL=

# true when DATABASE_URL goes through the Supabase pooler (transaction mode).
DATABASE_PGBOUNCER=false

# Connections per server instance (1 to 50).
DATABASE_POOL_MAX=5

# Optional fail-fast limits; the defaults suit Vercel with the Supabase pooler.
# A value that cannot be read is ignored (the default applies) and named on
# the admin "Platform health" page; it never stops the server.
# Seconds an idle connection stays open (1 to 3600, default 60).
# DATABASE_IDLE_TIMEOUT_SECONDS=60
# Longest single SQL statement in a normal request, in ms (1000 to 120000,
# default 10000). Past it the request answers "busy, try again".
# DATABASE_STATEMENT_TIMEOUT_MS=10000
# Longest wait for a free pooled connection, in ms (500 to 60000, default 8000).
# DATABASE_QUEUE_TIMEOUT_MS=8000

# ---------------------------------------------------------------------
# File storage
# ---------------------------------------------------------------------

# local: the server disk (development only) | supabase: Supabase Storage
# (production on Vercel).
STORAGE_DRIVER=local

# Folder for STORAGE_DRIVER=local.
LOCAL_STORAGE_DIR=./storage

# Required with STORAGE_DRIVER=supabase.
# SUPABASE_URL=https://your-project-ref.supabase.co

# Required with STORAGE_DRIVER=supabase. The service_role key: server only,
# full access to the project. Never expose it to the browser.
# SUPABASE_SERVICE_ROLE_KEY=

# Private bucket for paid files. Never made public.
SUPABASE_PRIVATE_BUCKET=private-content

# Public bucket for covers, logos and teacher photos.
SUPABASE_PUBLIC_BUCKET=public-media

# Per-file upload limit with Supabase. free = 50 MB, the safe default. After
# upgrading set paid and raise "Global file size limit" in Supabase
# (Storage -> Settings).
STORAGE_PLAN=free

# Optional explicit per-file limit in MB (1 to 8192). Overrides STORAGE_PLAN
# and must match the Supabase "Global file size limit".
# STORAGE_MAX_FILE_MB=500

# ---------------------------------------------------------------------
# Payments (MyFatoorah)
# ---------------------------------------------------------------------

# disabled: no online payment | sandbox: MyFatoorah test environment |
# live: real payments.
PAYMENTS_MODE=disabled

# API key from the MyFatoorah portal (demo key for sandbox, production key
# for live). Secret.
# MYFATOORAH_API_KEY=

# Leave unset: the official address is chosen from PAYMENTS_MODE
# (sandbox https://apitest.myfatoorah.com, live Kuwait
# https://api.myfatoorah.com). Only MyFatoorah's official API hosts are
# accepted; anything else switches payments off. The one exception is a
# local simulator: sandbox mode, not on Vercel, with APP_URL on localhost too.
# MYFATOORAH_BASE_URL=https://apitest.myfatoorah.com

# Webhook V2 secret key from the MyFatoorah portal (Integration Settings ->
# Webhook Settings). Required in sandbox and live. Secret.
# MYFATOORAH_WEBHOOK_SECRET=

# Must be set to true on purpose before live mode works, after the merchant
# account is approved.
MYFATOORAH_LIVE_CONFIRMED=false

# sandbox is refused on a NODE_ENV=production deployment whose domain does
# not look like a test one (Vercel previews and hosts such as staging.* are
# allowed). true allows it for a deliberate test on such a deployment.
ALLOW_SANDBOX_ON_PRODUCTION=false

# ---------------------------------------------------------------------
# Scheduled jobs and owner alerts
# ---------------------------------------------------------------------

# Secret for /api/cron/*. Vercel sends it as Authorization: Bearer. At least
# 16 random characters (openssl rand -hex 32). Without it every job answers
# 401 and does not run; the site itself keeps working. Secret.
# CRON_SECRET=

# Owner address for operations alerts (new error, dispute, extra payment,
# stuck refund, stopped job). Messages leave only with MAIL_DRIVER=smtp.
# OPS_ALERT_EMAIL=owner@your-domain.com

# ---------------------------------------------------------------------
# Email
# ---------------------------------------------------------------------

# log: messages are stored inside the platform and reach nobody; no reset
# links by email and no email verification.
# smtp: real sending; needs SMTP_HOST and a real MAIL_FROM. Email
# verification before the first payment is then enforced.
MAIL_DRIVER=log

# Required with MAIL_DRIVER=smtp.
# SMTP_HOST=smtp.your-mail-provider.com

# SMTP port: usually 587 (STARTTLS) or 465 (implicit TLS).
SMTP_PORT=587

# SMTP user name from the mail provider.
# SMTP_USER=

# SMTP password or API key from the mail provider. Secret.
# SMTP_PASSWORD=

# true for implicit TLS (usually port 465); false for STARTTLS on 587.
SMTP_SECURE=false

# Required with MAIL_DRIVER=smtp: an address on your real domain, either
# address@domain or "Name <address@domain>". Example domains are refused.
# MAIL_FROM="Farqad <no-reply@your-domain.com>"

# ---------------------------------------------------------------------
# Video
# ---------------------------------------------------------------------

# file: videos go to the platform's private storage and stream through the
# server. In production a file video cannot be published or sold, because
# the student can download it, unless ALLOW_FILE_VIDEO=true. A notes-only
# launch keeps file and leaves ALLOW_FILE_VIDEO false.
# bunny: Bunny Stream (recommended for selling video): direct upload,
# automatic qualities, signed embed links.
VIDEO_PROVIDER=file

# true is an explicit decision to publish and sell downloadable file videos
# in production.
ALLOW_FILE_VIDEO=false

# With VIDEO_PROVIDER=bunny the next four are required: the build fails and
# the server will not start, naming what is missing.
# BUNNY_STREAM_LIBRARY_ID=

# Library API key (AccessKey). Secret.
# BUNNY_STREAM_API_KEY=

# Embed view token authentication key from the library Security settings.
# Secret.
# BUNNY_STREAM_TOKEN_KEY=

# Read-only API key, used to verify Bunny webhook signatures. Secret.
# BUNNY_STREAM_READONLY_API_KEY=

# Library CDN hostname for thumbnails, such as vz-xxxxxxxx-xxx.b-cdn.net.
# BUNNY_STREAM_CDN_HOSTNAME=

# Bunny addresses. The defaults are the official ones; leave unset.
# BUNNY_STREAM_API_BASE=https://video.bunnycdn.com
# BUNNY_STREAM_TUS_ENDPOINT=https://video.bunnycdn.com/tusupload
# BUNNY_STREAM_EMBED_BASE=https://iframe.mediadelivery.net

# ---------------------------------------------------------------------
# Admin accounts
# ---------------------------------------------------------------------

# Two-factor sign-in for admin accounts is required in production. false
# turns it off; use that only on a test deployment where no real money
# moves. true also requires it outside production.
# ADMIN_2FA_REQUIRED=false
